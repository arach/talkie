#!/bin/bash
#
# TalkieBridge management CLI
#
# Usage:
#   bridge install     - Install launchd services and DNS entries
#   bridge uninstall   - Remove launchd services
#   bridge start       - Start production bridge (port 8765)
#   bridge stop        - Stop production bridge
#   bridge dev         - Start dev bridge (port 8767, --local mode)
#   bridge dev:stop    - Stop dev bridge
#   bridge status      - Show status of both services
#   bridge doctor      - Validate launchd and health guardrails
#   bridge logs        - Tail production logs
#   bridge logs:dev    - Tail dev logs
#   bridge dns         - Add /etc/hosts entries (requires sudo)
#   bridge dns:remove  - Remove /etc/hosts entries (requires sudo)
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BRIDGE_DIR="$(dirname "$SCRIPT_DIR")"
LAUNCHD_DIR="$BRIDGE_DIR/launchd"
LAUNCH_AGENTS="$HOME/Library/LaunchAgents"
LOG_DIR="$HOME/Library/Logs/TalkieBridge"

PROD_PLIST="to.talkie.bridge.plist"
DEV_PLIST="to.talkie.bridge.dev.plist"
PROD_LABEL="to.talkie.bridge"
DEV_LABEL="to.talkie.bridge.dev"
LEGACY_PROD_PLIST="com.talkie.bridge.plist"
LEGACY_DEV_PLIST="com.talkie.bridge-dev.plist"
LEGACY_PROD_LABEL="com.talkie.bridge"
LEGACY_DEV_LABEL="com.talkie.bridge-dev"

# DNS entry - single subdomain, different ports
HOSTS_MARKER="# TalkieBridge DNS"
HOSTS_ENTRIES="
127.0.0.1   dev.usetalkie.com
"

resolve_bun_bin() {
    if [ -n "${TALKIE_BUN_BIN:-}" ] && [ -x "$TALKIE_BUN_BIN" ]; then
        echo "$TALKIE_BUN_BIN"
        return 0
    fi

    local from_path
    from_path="$(command -v bun 2>/dev/null || true)"

    local candidate
    for candidate in "$from_path" /opt/homebrew/bin/bun /usr/local/bin/bun "$HOME/.bun/bin/bun"; do
        if [ -n "$candidate" ] && [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done

    return 1
}

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() { echo -e "${BLUE}→${NC} $1"; }
log_success() { echo -e "${GREEN}✓${NC} $1"; }
log_warn() { echo -e "${YELLOW}⚠${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1"; }

healthy_url_for_port() {
    local port="$1"
    local candidate

    for candidate in "127.0.0.1" "localhost"; do
        if curl -s "http://$candidate:$port/health" > /dev/null 2>&1; then
            echo "http://$candidate:$port/health"
            return 0
        fi
    done

    if command -v tailscale > /dev/null 2>&1; then
        while IFS= read -r candidate; do
            if [ -n "$candidate" ] && curl -s "http://$candidate:$port/health" > /dev/null 2>&1; then
                echo "http://$candidate:$port/health"
                return 0
            fi
        done < <(tailscale ip -4 2>/dev/null || true)
    fi

    return 1
}

json_field() {
    local json="$1"
    local field="$2"

    if command -v jq > /dev/null 2>&1; then
        echo "$json" | jq -r --arg field "$field" 'if has($field) then .[$field] else empty end' 2>/dev/null || true
        return
    fi

    if command -v python3 > /dev/null 2>&1; then
        JSON_PAYLOAD="$json" JSON_FIELD="$field" python3 -c 'import json, os; value=json.loads(os.environ["JSON_PAYLOAD"]).get(os.environ["JSON_FIELD"]); print(str(value).lower() if isinstance(value, bool) else value) if value is not None else None' 2>/dev/null || true
    fi
}

legacy_plist_paths() {
    echo "$LAUNCH_AGENTS/$LEGACY_PROD_PLIST"
    echo "$LAUNCH_AGENTS/$LEGACY_DEV_PLIST"
}

stop_loaded_label() {
    local label="$1"
    launchctl stop "$label" 2>/dev/null || true
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    launchctl unload "$LAUNCH_AGENTS/$label.plist" 2>/dev/null || true
}

label_is_loaded() {
    local label="$1"
    launchctl print "gui/$(id -u)/$label" > /dev/null 2>&1
}

remove_legacy_plists() {
    log_info "Removing legacy bridge launchd labels if present..."
    stop_loaded_label "$LEGACY_PROD_LABEL"
    stop_loaded_label "$LEGACY_DEV_LABEL"
    rm -f "$LAUNCH_AGENTS/$LEGACY_PROD_PLIST"
    rm -f "$LAUNCH_AGENTS/$LEGACY_DEV_PLIST"
}

health_is_pairable() {
    local health="$1"
    local mode pairing_ready
    mode="$(json_field "$health" mode)"
    pairing_ready="$(json_field "$health" pairingReady)"

    [ "$mode" != "local_dev" ] && [ "$pairing_ready" != "false" ]
}

dev_plist_state() {
    if [ ! -f "$LAUNCH_AGENTS/$DEV_PLIST" ]; then
        echo "absent"
    elif grep -q '<string>--port</string>' "$LAUNCH_AGENTS/$DEV_PLIST" \
        && grep -q '<string>8767</string>' "$LAUNCH_AGENTS/$DEV_PLIST"; then
        echo "ok"
    else
        echo "stale"
    fi
}

ensure_log_dir() {
    mkdir -p "$LOG_DIR"
}

install_plists() {
    log_info "Installing launchd plists..."
    mkdir -p "$LAUNCH_AGENTS"
    ensure_log_dir

    # Stop services if running (prevents "service already loaded" errors)
    launchctl unload "$LAUNCH_AGENTS/$PROD_PLIST" 2>/dev/null || true
    launchctl unload "$LAUNCH_AGENTS/$DEV_PLIST" 2>/dev/null || true
    remove_legacy_plists

    # Generate plists with correct paths for this machine
    generate_plist "$PROD_LABEL" "" "$LAUNCH_AGENTS/$PROD_PLIST" "bridge.log"
    generate_plist "$DEV_LABEL" "--local --port 8767" "$LAUNCH_AGENTS/$DEV_PLIST" "bridge-dev.log"
    chmod 644 "$LAUNCH_AGENTS/$PROD_PLIST" "$LAUNCH_AGENTS/$DEV_PLIST"

    log_success "Installed to $LAUNCH_AGENTS"
    log_info "Paths configured for: $BRIDGE_DIR"
}

generate_plist() {
    local label="$1"
    local extra_args="$2"
    local output_path="$3"
    local log_name="$4"
    local bun_path
    if ! bun_path="$(resolve_bun_bin)"; then
        log_error "Could not find bun. Install Bun or set TALKIE_BUN_BIN."
        exit 1
    fi
    local bun_dir
    bun_dir="$(dirname "$bun_path")"

    local args="<string>$bun_path</string>
        <string>run</string>
        <string>src/server.ts</string>"

    if [ -n "$extra_args" ]; then
        local arg
        for arg in $extra_args; do
            args="$args
        <string>$arg</string>"
        done
    fi

    cat > "$output_path" << EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$label</string>

    <key>ProgramArguments</key>
    <array>
        $args
    </array>

    <key>WorkingDirectory</key>
    <string>$BRIDGE_DIR</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>$bun_dir:/opt/homebrew/bin:/usr/local/bin:$HOME/.bun/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>$LOG_DIR/$log_name</string>

    <key>StandardErrorPath</key>
    <string>$LOG_DIR/${log_name%.log}.error.log</string>
</dict>
</plist>
EOF
}

uninstall_plists() {
    log_info "Uninstalling launchd plists..."

    # Stop services first
    launchctl unload "$LAUNCH_AGENTS/$PROD_PLIST" 2>/dev/null || true
    launchctl unload "$LAUNCH_AGENTS/$DEV_PLIST" 2>/dev/null || true
    remove_legacy_plists

    # Remove plists
    rm -f "$LAUNCH_AGENTS/$PROD_PLIST"
    rm -f "$LAUNCH_AGENTS/$DEV_PLIST"

    log_success "Uninstalled"
}

start_prod() {
    ensure_log_dir
    log_info "Starting production bridge (port 8765)..."

    if ! [ -f "$LAUNCH_AGENTS/$PROD_PLIST" ]; then
        log_error "Not installed. Run: bridge install"
        exit 1
    fi

    launchctl load -w "$LAUNCH_AGENTS/$PROD_PLIST" 2>/dev/null || true
    launchctl start "$PROD_LABEL" 2>/dev/null || true

    sleep 1
    local health_url
    if health_url="$(healthy_url_for_port 8765)"; then
        local health
        health="$(curl -s "$health_url" 2>/dev/null)"
        if health_is_pairable "$health"; then
            log_success "Production bridge running at ${health_url%/health}"
        else
            log_error "Port 8765 is serving a non-pairable bridge; run: bridge doctor"
            exit 1
        fi
    else
        log_warn "Started but health check failed - check logs: bridge logs"
    fi
}

stop_prod() {
    log_info "Stopping production bridge..."
    launchctl stop "$PROD_LABEL" 2>/dev/null || true
    launchctl unload "$LAUNCH_AGENTS/$PROD_PLIST" 2>/dev/null || true
    log_success "Stopped"
}

start_dev() {
    ensure_log_dir
    log_info "Starting dev bridge (port 8767, local mode)..."

    if ! [ -f "$LAUNCH_AGENTS/$DEV_PLIST" ]; then
        log_error "Not installed. Run: bridge install"
        exit 1
    fi

    launchctl load -w "$LAUNCH_AGENTS/$DEV_PLIST" 2>/dev/null || true
    launchctl start "$DEV_LABEL" 2>/dev/null || true

    sleep 1
    local health
    health="$(curl -s http://localhost:8767/health 2>/dev/null || true)"
    if [ -n "$health" ] && [ "$(json_field "$health" mode)" = "local_dev" ]; then
        log_success "Dev bridge running at http://dev.usetalkie.com:8767"
    elif [ -n "$health" ]; then
        local service
        service="$(json_field "$health" service)"
        log_error "Port 8767 is serving ${service:-another service}, not the dev bridge"
        exit 1
    else
        log_warn "Started but health check failed - check logs: bridge logs:dev"
    fi
}

stop_dev() {
    log_info "Stopping dev bridge..."
    launchctl stop "$DEV_LABEL" 2>/dev/null || true
    launchctl unload "$LAUNCH_AGENTS/$DEV_PLIST" 2>/dev/null || true
    log_success "Stopped"
}

show_status() {
    echo ""
    echo "TalkieBridge Status"
    echo "==================="
    echo ""

    # apps/ios/Production (8765)
    local health_url
    if health_url="$(healthy_url_for_port 8765)"; then
        local health=$(curl -s "$health_url" 2>/dev/null)
        local mode pairing_ready host version
        mode="$(json_field "$health" mode)"
        pairing_ready="$(json_field "$health" pairingReady)"
        host="$(json_field "$health" hostname)"
        version="$(json_field "$health" version)"

        if health_is_pairable "$health"; then
            echo -e "${GREEN}●${NC} :8765 apps/ios/Tailscale"
        else
            echo -e "${RED}●${NC} :8765 apps/ios/Tailscale - not pairable"
        fi
        echo "    Version: ${version:-unknown}  Host: ${host:-unknown}  Mode: ${mode:-unknown}  Pairing ready: ${pairing_ready:-unknown}"
        if ! health_is_pairable "$health"; then
            echo "    Fix: run bridge doctor; stale local-dev bridge may be occupying the production port."
        fi
    else
        echo -e "${RED}○${NC} :8765 apps/ios/Tailscale - not running"
    fi

    echo ""

    # Talkie (8766) - just check if port is in use
    if lsof -i :8766 > /dev/null 2>&1; then
        echo -e "${GREEN}●${NC} :8766 Talkie macOS"
        echo "    (Managed by Talkie.app)"
    else
        echo -e "${YELLOW}○${NC} :8766 Talkie macOS - not running"
        echo "    (Start Talkie.app to enable)"
    fi

    echo ""

    # Dev (8767)
    if curl -s http://localhost:8767/health > /dev/null 2>&1; then
        local health=$(curl -s http://localhost:8767/health 2>/dev/null)
        local service=$(json_field "$health" service)
        if [ "$service" = "TalkieAgent" ]; then
            echo -e "${GREEN}●${NC} :8767 TalkieAgent"
            echo "    Version: $(json_field "$health" version)"
        else
            local mode pairing_ready
            mode="$(json_field "$health" mode)"
            pairing_ready="$(json_field "$health" pairingReady)"
            echo -e "${GREEN}●${NC} :8767 Dev (local mode)"
            echo "    Version: $(json_field "$health" version)  Mode: ${mode:-unknown}  Pairing ready: ${pairing_ready:-unknown}"
        fi
    else
        echo -e "${RED}○${NC} :8767 Dev - not running"
    fi

    echo ""

    # launchd plist check
    local dev_status
    dev_status="$(dev_plist_state)"
    case "$dev_status" in
        ok)
            echo -e "${GREEN}●${NC} Dev launchd plist pins --port 8767"
            ;;
        stale)
            echo -e "${RED}●${NC} Dev launchd plist is stale - missing --port 8767"
            ;;
        *)
            echo -e "${YELLOW}○${NC} Dev launchd plist not installed"
            ;;
    esac

    while IFS= read -r legacy_path; do
        if [ -f "$legacy_path" ]; then
            echo -e "${YELLOW}●${NC} Legacy plist present: $legacy_path"
        fi
    done < <(legacy_plist_paths)
    for legacy_label in "$LEGACY_PROD_LABEL" "$LEGACY_DEV_LABEL"; do
        if label_is_loaded "$legacy_label"; then
            echo -e "${YELLOW}●${NC} Legacy launchd label loaded: $legacy_label"
        fi
    done

    echo ""

    # DNS check
    if grep -q "usetalkie.com" /etc/hosts 2>/dev/null; then
        echo -e "${GREEN}●${NC} DNS entries configured"
    else
        echo -e "${YELLOW}○${NC} DNS entries not configured - run: sudo bridge dns"
    fi

    echo ""
}

doctor() {
    local failures=0

    echo ""
    echo "TalkieBridge Doctor"
    echo "===================="
    echo ""

    local legacy_found=0
    while IFS= read -r legacy_path; do
        if [ -f "$legacy_path" ]; then
            log_error "Legacy launchd plist present: $legacy_path"
            legacy_found=1
        fi
    done < <(legacy_plist_paths)
    for legacy_label in "$LEGACY_PROD_LABEL" "$LEGACY_DEV_LABEL"; do
        if label_is_loaded "$legacy_label"; then
            log_error "Legacy launchd label loaded: $legacy_label"
            legacy_found=1
        fi
    done
    if [ "$legacy_found" -eq 1 ]; then
        echo "  Run: bridge install   # rewrites canonical plists and removes legacy com.talkie.bridge* plists"
        failures=$((failures + 1))
    else
        log_success "No legacy com.talkie.bridge* plists installed"
    fi

    local dev_state
    dev_state="$(dev_plist_state)"
    case "$dev_state" in
        ok)
            log_success "Dev bridge plist pins local mode to --port 8767"
            ;;
        stale)
            log_error "Dev bridge plist is stale or malformed: missing --port 8767"
            echo "  Run: bridge install"
            failures=$((failures + 1))
            ;;
        *)
            log_warn "Dev bridge plist is not installed"
            ;;
    esac

    local health_url
    if health_url="$(healthy_url_for_port 8765)"; then
        local health mode pairing_ready host
        health="$(curl -s "$health_url" 2>/dev/null)"
        mode="$(json_field "$health" mode)"
        pairing_ready="$(json_field "$health" pairingReady)"
        host="$(json_field "$health" hostname)"

        if health_is_pairable "$health"; then
            log_success ":8765 is pairable (host=${host:-unknown}, mode=${mode:-unknown})"
        else
            log_error ":8765 is not pairable (host=${host:-unknown}, mode=${mode:-unknown}, pairingReady=${pairing_ready:-unknown})"
            echo "  This is the failure mode that makes Agent Home show SERVER ERROR."
            echo "  Stop the stale local-dev listener and reinstall bridge plists."
            failures=$((failures + 1))
        fi
    else
        log_warn ":8765 is not currently listening"
    fi

    echo ""
    if [ "$failures" -eq 0 ]; then
        log_success "Doctor passed"
    else
        log_error "Doctor found $failures issue(s)"
        return 1
    fi
}

tail_logs() {
    local log_file="$LOG_DIR/bridge.log"
    local err_file="$LOG_DIR/bridge.error.log"

    if [ ! -f "$log_file" ]; then
        log_warn "No logs yet at $log_file"
        return
    fi

    log_info "Tailing $log_file (Ctrl+C to stop)"
    tail -f "$log_file" "$err_file" 2>/dev/null
}

tail_dev_logs() {
    local log_file="$LOG_DIR/bridge-dev.log"
    local err_file="$LOG_DIR/bridge-dev.error.log"

    if [ ! -f "$log_file" ]; then
        log_warn "No logs yet at $log_file"
        return
    fi

    log_info "Tailing $log_file (Ctrl+C to stop)"
    tail -f "$log_file" "$err_file" 2>/dev/null
}

add_dns() {
    log_info "Adding DNS entries to /etc/hosts..."

    if grep -q "$HOSTS_MARKER" /etc/hosts 2>/dev/null; then
        log_warn "DNS entries already exist"
        return
    fi

    echo "" | sudo tee -a /etc/hosts > /dev/null
    echo "$HOSTS_MARKER" | sudo tee -a /etc/hosts > /dev/null
    echo "$HOSTS_ENTRIES" | sudo tee -a /etc/hosts > /dev/null

    # Flush DNS cache
    sudo dscacheutil -flushcache
    sudo killall -HUP mDNSResponder 2>/dev/null || true

    log_success "DNS entry added: dev.usetalkie.com → 127.0.0.1"
    echo ""
    echo "  Ports:"
    echo "    :8765 - apps/ios/Tailscale"
    echo "    :8766 - Talkie macOS app"
    echo "    :8767 - localhost dev"
}

remove_dns() {
    log_info "Removing DNS entries from /etc/hosts..."

    if ! grep -q "$HOSTS_MARKER" /etc/hosts 2>/dev/null; then
        log_warn "No DNS entries found"
        return
    fi

    # Remove our entries (marker + next 3 lines)
    sudo sed -i '' "/$HOSTS_MARKER/,+3d" /etc/hosts

    # Flush DNS cache
    sudo dscacheutil -flushcache
    sudo killall -HUP mDNSResponder 2>/dev/null || true

    log_success "DNS entries removed"
}

show_help() {
    echo "TalkieBridge CLI"
    echo ""
    echo "Usage: bridge <command>"
    echo ""
    echo "Services:                          dev.usetalkie.com"
    echo "  start        Production bridge   :8765 (Tailscale)"
    echo "  stop         Stop production"
    echo "  dev          Dev bridge          :8767 (local mode)"
    echo "  dev:stop     Stop dev"
    echo "  restart      Restart production"
    echo "  status       Show all services"
    echo "  doctor       Validate launchd plists and pairing health"
    echo ""
    echo "Logs:"
    echo "  logs         Tail production logs"
    echo "  logs:dev     Tail dev logs"
    echo ""
    echo "Setup:"
    echo "  install      Install launchd services"
    echo "  uninstall    Remove launchd services"
    echo "  dns          Add dev.usetalkie.com to /etc/hosts"
    echo ""
}

# Main
case "${1:-}" in
    install)
        install_plists
        log_info "Next: sudo bridge dns (to add DNS entries)"
        ;;
    uninstall)
        uninstall_plists
        ;;
    start)
        start_prod
        ;;
    stop)
        stop_prod
        ;;
    restart)
        stop_prod
        sleep 1
        start_prod
        ;;
    dev)
        start_dev
        ;;
    dev:stop)
        stop_dev
        ;;
    status)
        show_status
        ;;
    doctor)
        doctor
        ;;
    logs)
        tail_logs
        ;;
    logs:dev)
        tail_dev_logs
        ;;
    dns)
        add_dns
        ;;
    dns:remove)
        remove_dns
        ;;
    help|--help|-h|"")
        show_help
        ;;
    *)
        log_error "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
