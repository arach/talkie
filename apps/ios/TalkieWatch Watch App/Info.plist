<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconFiles</key>
	<array>
		<string>AppIcon</string>
	</array>
	<!-- Answers are spoken, and speaking one takes longer than a wrist stays
	     up. Without this watchOS suspends the app the moment the arm drops and
	     the answer stops mid-sentence, which reads as a crash rather than a
	     policy. The app plays audio only while an answer is actually speaking. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Read at runtime rather than hardcoded, so the app and the complication
	     extension cannot drift onto different containers. -->
	<key>TalkieAppGroupIdentifier</key>
	<string>$(TALKIE_IOS_APP_GROUP)</string>
</dict>
</plist>
